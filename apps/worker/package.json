{
  "name": "@openpool/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir ../../dist/worker",
    "build:production": "wrangler deploy --dry-run --env production --outdir ../../dist/worker-production",
    "cf:typegen": "wrangler types src/generated/worker-configuration.d.ts --include-runtime false",
    "db:migrate:local": "wrangler d1 migrations apply openpool --local",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "deploy:production": "wrangler deploy --env production --strict",
    "deploy:staging": "wrangler deploy --env staging",
    "dev": "wrangler dev --port 8787",
    "dev:scheduled": "wrangler dev --port 8787 --test-scheduled",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/core": "3.977.9",
    "@aws-sdk/s3-request-presigner": "3.1123.0",
    "@openpool/application": "*",
    "@openpool/contracts": "*",
    "@openpool/domain": "*",
    "@smithy/core": "3.33.3",
    "hono": "^4.13.5"
  }
}
